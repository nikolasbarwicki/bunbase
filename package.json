{
  "name": "bunbase",
  "private": true,
  "license": "MIT",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "knip": "knip",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run knip && bun test",
    "prepare": "lefthook install",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "knip": "^6.41.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "ultracite": "^8.0.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
